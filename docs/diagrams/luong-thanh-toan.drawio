3" as="offset"/></mxGeometry></mxCell><mxCell id="m9" value="&amp;nbsp;&lt;b&gt;3. POST /v1/payments&lt;/b&gt;&amp;nbsp;&lt;br&gt;&amp;nbsp;TLS, Bearer API key&amp;nbsp;&lt;br&gt;&amp;nbsp;Idempotency-Key = mã đơn&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=block;endFill=1;endSize=7;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=0.54286;exitY=0.39064;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.39064;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="app" target="gw"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m10" value="&amp;nbsp;txn_id, pay_url&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=open;endFill=0;endSize=9;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0.41596;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.54286;entryY=0.41596;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="gw" target="app"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m11" value="&amp;nbsp;lưu txn_id vào đơn&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=block;endFill=1;endSize=7;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=0.54286;exitY=0.44129;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.44129;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="app" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m12" value="&amp;nbsp;201: order_id, pay_url&amp;nbsp;&lt;br&gt;&amp;nbsp;(chuyển sang trang của cổng)&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=open;endFill=0;endSize=9;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.45714;exitY=0.47813;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.47813;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="app" target="browser"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m13" value="&amp;nbsp;&lt;b&gt;4. Thanh toán trên trang của cổng&lt;/b&gt;&amp;nbsp;&lt;br&gt;&amp;nbsp;số thẻ không đi qua G-Shop&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=block;endFill=1;endSize=7;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.52264;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.52264;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="browser" target="gw"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m14" value="&amp;nbsp;&lt;b&gt;5. POST /v1/transactions&lt;/b&gt;&amp;nbsp;&lt;br&gt;&amp;nbsp;mTLS&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=block;endFill=1;endSize=7;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.56715;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.56715;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="gw" target="bank"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m15" value="&amp;nbsp;bank_ref&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=open;endFill=0;endSize=9;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0.59248;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.59248;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="bank" target="gw"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m16" value='&amp;nbsp;&lt;b&gt;6. POST /api/payments/webhook&lt;/b&gt;&amp;nbsp;&lt;br&gt;&amp;nbsp;HMAC-SHA256 trên "timestamp.body"&amp;nbsp;&lt;br&gt;&amp;nbsp;X-GS-Timestamp, X-GS-Signature&amp;nbsp;' style="html=1;edgeStyle=none;endArrow=block;endFill=1;endSize=7;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.6485;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.6485;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="gw" target="web"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m17" value="&amp;nbsp;chuyển tiếp&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=block;endFill=1;endSize=7;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0.67383;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.45714;entryY=0.67383;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="web" target="app"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="n18" value="&lt;b&gt;7. App kiểm tra&lt;/b&gt;&lt;br&gt;• chữ ký HMAC đúng&lt;br&gt;• timestamp trong ±5 phút&lt;br&gt;• event_id chưa xử lý&lt;br&gt;• txn_id, order_id, số tiền&lt;br&gt;   khớp với đơn" style="rounded=1;arcSize=6;html=1;fillColor=#FFFFFF;strokeColor=#5F8FD0;strokeWidth=1.2;fontSize=12;fontColor=#1F2933;align=left;verticalAlign=middle;spacingLeft=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="300" y="900" width="200" height="110" as="geometry"/></mxCell><mxCell id="m19" value="&amp;nbsp;&lt;b&gt;8. GET /v1/transactions/{bank_ref}&lt;/b&gt;&amp;nbsp;&lt;br&gt;&amp;nbsp;mTLS, đối soát giao dịch&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=block;endFill=1;endSize=7;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=0.54286;exitY=0.81044;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.81044;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="app" target="bank"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m20" value="&amp;nbsp;status, txn_id, amount_vnd&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=open;endFill=0;endSize=9;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0.83576;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.54286;entryY=0.83576;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="bank" target="app"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m21" value="&amp;nbsp;&lt;b&gt;9. Cập nhật PAID&lt;/b&gt;&amp;nbsp;&lt;br&gt;&amp;nbsp;+ ghi audit log&amp;nbsp;&lt;br&gt;&amp;nbsp;(một transaction)&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=block;endFill=1;endSize=7;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;exitX=0.54286;exitY=0.89179;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0.89179;entryDx=0;entryDy=0;entryPerimeter=0;fontFamily=Arial;" edge="1" parent="1" source="app" target="db"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="m22" value="&amp;nbsp;200 paid (trả lời webhook)&amp;nbsp;" style="html=1;edgeStyle=none;endArrow=open;endFill=0;endSize=9;strokeColor=#37474F;strokeWidth=1.4;fontSize=12;fontColor=#1F2933;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.54286;exitY=0.91711;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5